---
layout: base.njk
pagination:
    data: site.years
    size: 1
    alias: year
permalink: "/seasons/{{ year }}/"
eleventyComputed:
    title: "{{ year }} Projection Accuracy"
---

{% macro renderEverybodyMissed(everybodyMissedData, statName, showVolume=false) %}
  {% if everybodyMissedData %}
    {% set misses = everybodyMissedData %}

    {# Find which projection systems have data for this stat #}
    {% set systemsWithData = [] %}
    {% for miss in misses %}
      {% for system, projection in miss.projections %}
        {% if projection and system not in systemsWithData %}
          {% set systemsWithData = (systemsWithData.push(system), systemsWithData) %}
        {% endif %}
      {% endfor %}
    {% endfor %}

    <div class="mb-8">
      <h3 class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-4">Everybody Missed for {{ statName }}</h3>
      <div class="bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-4">
        <div class="relative overflow-x-auto">
          <table class="w-full text-sm text-left text-slate-600 dark:text-slate-300">
            <thead class="text-xs text-slate-700 uppercase bg-slate-50 dark:bg-slate-900 dark:text-slate-300">
              <tr>
                <th scope="col" class="px-4 py-2">Player</th>
                <th scope="col" class="px-4 py-2 text-right">Actual</th>
                {% for system in systemsWithData %}
                  <th scope="col" class="px-4 py-2 text-right">{{ system }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for miss in misses %}
                <tr class="bg-white border-b dark:bg-slate-900 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800">
                  <td class="px-4 py-2">
                    <a href="{{ ('/players/' + miss.player_id + '/') | url }}" class="text-blue-600 dark:text-blue-400 hover:underline">
                      {{ miss.player_name }}
                    </a>
                  </td>
                  <td class="px-4 py-2 font-mono text-right font-semibold text-slate-900 dark:text-slate-100">{{ miss.actual | toFixed(0 if showVolume else 4) }}</td>
                  {% for system in systemsWithData %}
                    {% set projection = miss.projections[system] %}
                    <td class="px-4 py-2 font-mono text-right">
                      {% if projection %}
                        <div>{{ projection.projected | toFixed(0 if showVolume else 4) }}</div>
                        <div class="text-xs text-red-600 dark:text-red-400">({{ projection.error | toFixed(1) }})</div>
                      {% endif %}
                    </td>
                  {% endfor %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  {% endif %}
{% endmacro %}

{# Macro for displaying biggest misses for a specific stat #}
{% macro renderBiggestMisses(yearData, playerType, stat, statName, showVolume=false, missesData=null) %}
{% set proj_colors = {
    'Marcel': 'text-amber-900 dark:text-amber-700',
    'Steamer': 'text-blue-600 dark:text-blue-400',
    'ZiPS': 'text-green-600 dark:text-green-400',
    'Razzball': 'text-red-600 dark:text-red-400',
    'Davenport': 'text-teal-600 dark:text-teal-400',
    'ATC': 'text-orange-600 dark:text-orange-400',
    'The BAT': 'text-purple-600 dark:text-purple-400',
    'The BAT X': 'text-purple-600 dark:text-purple-400',
    'OOPSY': 'text-pink-600 dark:text-pink-400'
} %}
<div class="mb-8">
    <h3 class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-4">Individual Misses for {{ statName }}</h3>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {% for system in site.meta.projection_systems %}
        {% set missesForSystem = null %}
        {% set playerTypeMisses = missesData.batting_misses if playerType == "batting" else missesData.pitching_misses %}
        {% set statMisses = playerTypeMisses[stat] if playerTypeMisses else null %}

        {% if statMisses %}
          {% for missResult in statMisses %}
            {% if missResult.system == system %}
              {% set missesForSystem = missResult.biggest_misses %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if missesForSystem %}
        <div class="bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-4">
          <h4 class="text-lg font-medium {{ proj_colors[system] or 'text-slate-600 dark:text-slate-400' }} mb-4">{{ system }}</h4>
          <div class="relative overflow-x-auto">
            <table class="w-full text-sm text-left text-slate-600 dark:text-slate-300">
              <thead class="text-xs text-slate-700 uppercase bg-slate-50 dark:bg-slate-800 dark:text-slate-300">
                <tr>
                  <th scope="col" class="px-4 py-2">Rank</th>
                  <th scope="col" class="px-4 py-2">Player</th>
                  <th scope="col" class="px-4 py-2 text-right">Proj</th>
                  <th scope="col" class="px-4 py-2 text-right">Actual</th>
                  <th scope="col" class="px-4 py-2 text-right">Error</th>
                </tr>
              </thead>
              <tbody>
                {% for miss in missesForSystem.slice(0, 10) %}
                <tr class="bg-white border-b dark:bg-slate-900 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800">
                  <td class="px-4 py-2 font-medium text-slate-900 dark:text-slate-100 font-mono">{{ loop.index }}</td>
                  <td class="px-4 py-2">
                    <a href="{{ ('/players/' + miss.player_id + '/') | url }}" class="text-blue-600 dark:text-blue-400 hover:underline">
                      {{ miss.player_name }}
                    </a>
                  </td>
                  <td class="px-4 py-2 font-mono text-right">{{ miss.projected | toFixed(0 if showVolume else 4) }}</td>
                  <td class="px-4 py-2 font-mono text-right">{{ miss.actual | toFixed(0 if showVolume else 4) }}</td>
                  <td class="px-4 py-2 font-semibold text-red-600 dark:text-red-400 font-mono text-right">{{ miss.error | toFixed(1) }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
        {% endif %}
        {% endfor %}
    </div>
</div>
{% endmacro %}

{% set battingStats = [
  { name: 'wOBA', stat: 'wOBA', isVolume: false },
  { name: 'Strikeout Rate', stat: 'SO/PA', isVolume: false },
  { name: 'Walk Rate', stat: 'BB/PA', isVolume: false },
  { name: 'Hit By Pitch Rate', stat: 'HBP/PA', isVolume: false },
  { name: 'Home Run Rate', stat: 'HR/BIP', isVolume: false },
  { name: 'BABIP', stat: 'BABIP', isVolume: false },
  { name: 'Single Rate', stat: '1B/(BIP-HR)', isVolume: false },
  { name: 'Double Rate', stat: '2B/(BIP-HR)', isVolume: false },
  { name: 'Triple Rate', stat: '3B/(BIP-HR)', isVolume: false },
  { name: 'Run Rate', stat: 'R/PA', isVolume: false },
  { name: 'RBI Rate', stat: 'RBI/PA', isVolume: false },
  { name: 'Stolen Base Rate', stat: 'SB/TOF', isVolume: false },
  { name: 'Batting Average', stat: 'AVG', isVolume: false },
  { name: 'On-Base Percentage', stat: 'OBP', isVolume: false },
  { name: 'Slugging Percentage', stat: 'SLG', isVolume: false }
] %}

{% set pitchingStats = [
  { name: 'wOBA', stat: 'wOBA', isVolume: false },
  { name: 'Strikeout Rate', stat: 'SO/BF', isVolume: false },
  { name: 'Walk Rate', stat: 'BB/BF', isVolume: false },
  { name: 'Hit By Pitch Rate', stat: 'HBP/BF', isVolume: false },
  { name: 'Home Run Rate', stat: 'HR/BIP', isVolume: false },
  { name: 'BABIP', stat: 'BABIP', isVolume: false },
  { name: 'Single Rate', stat: '1B/(BIP-HR)', isVolume: false },
  { name: 'Double Rate', stat: '2B/(BIP-HR)', isVolume: false },
  { name: 'Triple Rate', stat: '3B/(BIP-HR)', isVolume: false },
  { name: 'Run Rate', stat: 'R/BF', isVolume: false },
  { name: 'Earned Run Rate', stat: 'ER/BF', isVolume: false },
  { name: 'Win Rate', stat: 'W/G', isVolume: false },
  { name: 'Loss Rate', stat: 'L/G', isVolume: false },
  { name: 'Save Rate', stat: 'SV/G', isVolume: false },
  { name: 'Hold Rate', stat: 'HLD/G', isVolume: false },
  { name: 'ERA', stat: 'ERA', isVolume: false },
  { name: 'WHIP', stat: 'WHIP', isVolume: false }
] %}

{% set metrics = [
  { value: 'MAE', name: 'MAE', title: 'MAE' },
  { value: 'RMSE', name: 'RMSE', title: 'RMSE'}
] %}

{% set adjustments = [
  { value: 'weighted-league-adj', name: 'Weighted League-Adjusted' },
  { value: 'league-adj', name: 'League-Adjusted' },
  { value: 'raw', name: 'Raw' }
] %}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-slate-900 dark:text-slate-100 mb-4">{{ year }} Projection Evaluation</h1>
    </div>

    <!-- Batting Section -->
    <div class="space-y-8 mb-12">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-6">Batting Projection Accuracy</h2>

      <!-- Batting Volume Section -->
      <div class="chart-section mb-8">
        <div class="mb-4 py-4">
          <h4 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3">Plate Appearances (PA)</h4>
          <div class="flex flex-wrap gap-4">
            <select class="metric-select px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100">
              {% for metric in metrics %}<option value="{{ metric.value }}">{{ metric.title }}</option>{% endfor %}
            </select>
          </div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="MAE" data-adjustment="raw">
          <div class="h-128"><canvas id="battingVolumeMaeChart"></canvas></div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="RMSE" data-adjustment="raw">
          <div class="h-128"><canvas id="battingVolumeRmseChart"></canvas></div>
        </div>
      </div>

      <!-- Batting PA Biggest Misses -->
      {% set yearMisses = misses[year] %}
      {% if yearMisses %}
        {{ renderEverybodyMissed(yearMisses.everybody_missed_batting['PA'], 'Plate Appearances (PA)', true) }}
        {{ renderBiggestMisses(yearData, 'batting', 'PA', 'Plate Appearances (PA)', true, yearMisses) }}
      {% endif %}

      <!-- Individual Batting Rate Stats -->
      {% for statInfo in battingStats %}
      <div class="chart-section mb-8">
        <div class="mb-4 py-4">
          <h4 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3">{{ statInfo.name }}</h4>
          <div class="flex flex-wrap gap-4">
            <select class="metric-select px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100">
              {% for metric in metrics %}<option value="{{ metric.value }}">{{ metric.title }}</option>{% endfor %}
            </select>
            <select class="adjustment-select px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100">
              {% for adj in adjustments %}<option value="{{ adj.value }}">{{ adj.name }}</option>{% endfor %}
            </select>
          </div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="MAE" data-adjustment="raw">
          <div class="h-128"><canvas id="batting{{ statInfo.stat | replace("/", "") | replace("(", "") | replace(")", "") | replace("-", "") }}MaeChart"></canvas></div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="RMSE" data-adjustment="raw">
          <div class="h-128"><canvas id="batting{{ statInfo.stat | replace("/", "") | replace("(", "") | replace(")", "") | replace("-", "") }}RmseChart"></canvas></div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="MAE" data-adjustment="league-adj">
          <div class="h-128"><canvas id="batting{{ statInfo.stat | replace("/", "") | replace("(", "") | replace(")", "") | replace("-", "") }}LeagueAdjMaeChart"></canvas></div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="RMSE" data-adjustment="league-adj">
          <div class="h-128"><canvas id="batting{{ statInfo.stat | replace("/", "") | replace("(", "") | replace(")", "") | replace("-", "") }}LeagueAdjRmseChart"></canvas></div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="MAE" data-adjustment="weighted-league-adj">
          <div class="h-128"><canvas id="batting{{ statInfo.stat | replace("/", "") | replace("(", "") | replace(")", "") | replace("-", "") }}WLAMaeChart"></canvas></div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="RMSE" data-adjustment="weighted-league-adj">
          <div class="h-128"><canvas id="batting{{ statInfo.stat | replace("/", "") | replace("(", "") | replace(")", "") | replace("-", "") }}WLARmseChart"></canvas></div>
        </div>
      </div>

      <!-- Batting {{ statInfo.name }} Biggest Misses -->
      {% if yearMisses %}
        {{ renderEverybodyMissed(yearMisses.everybody_missed_batting[statInfo.stat], statInfo.name) }}
        {{ renderBiggestMisses(yearData, 'batting', statInfo.stat, statInfo.name, false, yearMisses) }}
      {% endif %}
      {% endfor %}
    </div>

    <!-- Pitching Section -->
    <div class="space-y-8 mb-12">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-6">Pitching Projection Accuracy</h2>

      <!-- Pitching Volume Section -->
      <div class="chart-section mb-8">
        <div class="mb-4 py-4">
          <h4 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3">Batters Faced (BF)</h4>
          <div class="flex flex-wrap gap-4">
            <select class="metric-select px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100">
              {% for metric in metrics %}<option value="{{ metric.value }}">{{ metric.title }}</option>{% endfor %}
            </select>
          </div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="MAE" data-adjustment="raw">
          <div class="h-128"><canvas id="pitchingVolumeMaeChart"></canvas></div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="RMSE" data-adjustment="raw">
          <div class="h-128"><canvas id="pitchingVolumeRmseChart"></canvas></div>
        </div>
      </div>

      <!-- Pitching BF Biggest Misses -->
      {% if yearMisses %}
        {{ renderEverybodyMissed(yearMisses.everybody_missed_pitching['BF'], 'Batters Faced (BF)', true) }}
        {{ renderBiggestMisses(yearData, 'pitching', 'BF', 'Batters Faced (BF)', true, yearMisses) }}
      {% endif %}

      <!-- Individual Pitching Rate Stats -->
      {% for statInfo in pitchingStats %}
      <div class="chart-section mb-8">
        <div class="mb-4 py-4">
          <h4 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3">{{ statInfo.name }}</h4>
          <div class="flex flex-wrap gap-4">
            <select class="metric-select px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100">
              {% for metric in metrics %}<option value="{{ metric.value }}">{{ metric.title }}</option>{% endfor %}
            </select>
            <select class="adjustment-select px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100">
              {% for adj in adjustments %}<option value="{{ adj.value }}">{{ adj.name }}</option>{% endfor %}
            </select>
          </div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="MAE" data-adjustment="raw">
          <div class="h-128"><canvas id="pitching{{ statInfo.stat | replace("/", "") | replace("(", "") | replace(")", "") | replace("-", "") }}MaeChart"></canvas></div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="RMSE" data-adjustment="raw">
          <div class="h-128"><canvas id="pitching{{ statInfo.stat | replace("/", "") | replace("(", "") | replace(")", "") | replace("-", "") }}RmseChart"></canvas></div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="MAE" data-adjustment="league-adj">
          <div class="h-128"><canvas id="pitching{{ statInfo.stat | replace("/", "") | replace("(", "") | replace(")", "") | replace("-", "") }}LeagueAdjMaeChart"></canvas></div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="RMSE" data-adjustment="league-adj">
          <div class="h-128"><canvas id="pitching{{ statInfo.stat | replace("/", "") | replace("(", "") | replace(")", "") | replace("-", "") }}LeagueAdjRmseChart"></canvas></div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="MAE" data-adjustment="weighted-league-adj">
          <div class="h-128"><canvas id="pitching{{ statInfo.stat | replace("/", "") | replace("(", "") | replace(")", "") | replace("-", "") }}WLAMaeChart"></canvas></div>
        </div>
        <div class="chart-container bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-6" data-metric="RMSE" data-adjustment="weighted-league-adj">
          <div class="h-128"><canvas id="pitching{{ statInfo.stat | replace("/", "") | replace("(", "") | replace(")", "") | replace("-", "") }}WLARmseChart"></canvas></div>
        </div>
      </div>

      <!-- Pitching {{ statInfo.name }} Biggest Misses -->
      {% if yearMisses %}
        {{ renderEverybodyMissed(yearMisses.everybody_missed_pitching[statInfo.stat], statInfo.name) }}
        {{ renderBiggestMisses(yearData, 'pitching', statInfo.stat, statInfo.name, false, yearMisses) }}
      {% endif %}
      {% endfor %}
    </div>



</div>

{% block scripts %}
<script>
    {% include "chart-utils.js" %}
    {% include "season-charts.js" %}
    document.addEventListener('DOMContentLoaded', function() {
        initializeSeasonCharts({{ years[year] | dump | safe }}, {{ site.meta.projection_systems | dump | safe }});
        initializeChartFilters();
    });

    function initializeChartFilters() {
        const chartSections = document.querySelectorAll('.chart-section');

        chartSections.forEach(section => {
            const metricSelect = section.querySelector('.metric-select');
            const adjustmentSelect = section.querySelector('.adjustment-select');

            function updateVisibility() {
                const selectedMetric = metricSelect.value;
                const selectedAdjustment = adjustmentSelect ? adjustmentSelect.value : 'raw';

                const chartContainers = section.querySelectorAll('.chart-container');
                chartContainers.forEach(container => {
                    const chartMetric = container.dataset.metric;
                    const chartAdjustment = container.dataset.adjustment;
                    const shouldShow = chartMetric === selectedMetric && chartAdjustment === selectedAdjustment;
                    container.style.display = shouldShow ? 'block' : 'none';
                });
            }

            metricSelect.addEventListener('change', updateVisibility);
            if (adjustmentSelect) {
                adjustmentSelect.addEventListener('change', updateVisibility);
            }

            updateVisibility();
        });
    }
</script>
{% endblock %}