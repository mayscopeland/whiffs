{
  "name": "whiffs",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "baseball": "npm run baseball:evals && npm run baseball:site && npm run baseball:css",
    "baseball:evals": "uv run python baseball/projection_evaluation.py",
    "baseball:site": "uv run python baseball/site_builder.py",
    "baseball:css": "npx @tailwindcss/cli -i ./baseball/assets/css/input.css -o ./baseball/_site/assets/css/style.css",
    "baseball:serve": "uv run python -m http.server 8080 --directory baseball/_site",
    "baseball:deploy": "npx wrangler pages deploy --cwd baseball",
    "baseball:stats": "uv run python baseball/utils/fetch_mlb_stats.py",
    "baseball:marcel": "uv run python baseball/utils/marcel-like.py",
    "basketball": "npm run basketball:evals && npm run basketball:site && npm run basketball:css",
    "basketball:evals": "uv run python basketball/projection_evaluation.py",
    "basketball:site": "uv run python basketball/site_builder.py",
    "basketball:css": "npx @tailwindcss/cli -i ./basketball/assets/css/input.css -o ./basketball/_site/assets/css/style.css",
    "basketball:serve": "uv run python -m http.server 8081 --directory basketball/_site",
    "basketball:deploy": "npx wrangler pages deploy --cwd basketball",
    "basketball:stats": "uv run python basketball/utils/fetch_nba_stats.py",
    "basketball:sps": "uv run python basketball/utils/sps.py",
    "basketball:darko": "uv run python basketball/utils/fetch_darko.py",
    "basketball:espn": "uv run python basketball/utils/fetch_espn.py",
    "basketball:preseason": "uv run python basketball/utils/fetch_preseason.py",
    "football": "npm run football:evals && npm run football:site && npm run football:css",
    "football:evals": "uv run python football/projection_evaluation.py",
    "football:site": "uv run python football/site_builder.py",
    "football:css": "npx @tailwindcss/cli -i ./football/assets/css/input.css -o ./football/_site/assets/css/style.css",
    "football:serve": "uv run python -m http.server 8082 --directory football/_site",
    "football:deploy": "npx wrangler pages deploy --cwd football",
    "football:stats": "uv run python football/utils/fetch_stats.py",
    "football:projections": "uv run python football/utils/fetch_espn.py",
    "football:espn": "uv run python football/utils/fetch_espn.py",
    "football:sleeper": "uv run python football/utils/fetch_sleeper.py",
    "football:fftoday": "uv run python football/utils/fetch_fftoday.py",
    "football:fantasypros": "uv run python football/utils/fetch_fantasypros.py",
    "football:adp": "uv run python football/utils/fetch_fantasypros_adp.py"
  },
  "author": "",
  "license": "AGPL-3.0",
  "dependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "wrangler": "^4.148.0"
  }
}
